<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- Portable source-level checks; these do not validate WPF or Windows net48. -->
  <ItemGroup>
    <Compile Include="../TiaAnalyzer.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../TiaAnalyzer.Openness/*.cs" Link="Openness/%(Filename)%(Extension)" />
    <Compile Include="../TiaAnalyzer.Export/*.cs" Link="Export/%(Filename)%(Extension)" />
    <Compile Include="../TiaAnalyzer.App/Infrastructure/*.cs" Link="Infrastructure/%(Filename)%(Extension)" />
    <Compile Include="../TiaAnalyzer.App/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
