<Window x:Class="TiaAnalyzer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TIA Project Analyzer · V0.5" Width="1180" Height="900" MinWidth="900" MinHeight="650" Background="#10171F" Foreground="#E5EDF5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E5EDF5"/><Setter Property="Background" Value="#263747"/><Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="#405469" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#37D5BC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#37D5BC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#192430"/><Setter Property="BorderBrush" Value="#2C3D4E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TIA / PROJECT ANALYZER" Foreground="#37D5BC" FontWeight="Bold"/><TextBlock Text="Project Analyzer" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="V0.5 / Siemens TIA Portal V21 · Export e analisi statica" Foreground="#A1B2C4"/></StackPanel><Border Grid.Column="1" Background="#203D3D" CornerRadius="5" Padding="16,10" VerticalAlignment="Center"><TextBlock Text="● SOLA LETTURA" Foreground="#65E1C8" FontWeight="Bold"/></Border></Grid>
  <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><DockPanel><TextBlock Text="01   AMBIENTE DI ESECUZIONE" FontWeight="Bold" Foreground="#A1B2C4"/><CheckBox x:Name="MockMode" Content="Modalità dimostrativa" Foreground="#E5EDF5" HorizontalAlignment="Right" IsChecked="{Binding IsDemo}" IsEnabled="{Binding CanChangeMode}"/></DockPanel><TextBlock x:Name="EnvironmentStatus" Text="{Binding EnvironmentStatus}" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBlock Text="Rilevamento automatico delle librerie installate. La verifica dei metadati non collega né modifica progetti TIA." Foreground="#A1B2C4"/><TextBlock x:Name="LibraryPath" Text="{Binding LibraryPath}" FontFamily="Consolas" FontSize="12" Foreground="#65E1C8" Margin="0,14,0,18"/><WrapPanel><Button x:Name="CheckButton" Content="Verifica disponibilità Openness" Command="{Binding CheckCommand}"/><TextBlock x:Name="LastCheck" Text="{Binding LastCheck}" VerticalAlignment="Center" Foreground="#A1B2C4"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="02   RISULTATI DEI CONTROLLI" Foreground="#A1B2C4" FontWeight="Bold" Margin="0,0,0,12"/><ItemsControl x:Name="Checks" ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#2C3D4E" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#65E1C8"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="ERRORE"><Setter Property="Foreground" Value="#FF8C87"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="DA VERIFICARE"><Setter Property="Foreground" Value="#F4C574"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#A1B2C4" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="03   SESSIONE TIA PORTAL" Foreground="#A1B2C4" FontWeight="Bold"/><TextBlock x:Name="SessionStatus" Text="{Binding SessionStatus}" FontSize="20" Margin="0,12,0,8"/><TextBlock Text="Rilevare le istanze, selezionare manualmente il PID e richiedere il collegamento. L'eventuale autorizzazione è gestita dal dialogo Siemens. Usare inizialmente un progetto di prova." Foreground="#A1B2C4" Margin="0,0,0,16"/><TextBlock Text="{Binding AdapterStatus}" Foreground="#F4C574" Margin="0,0,0,12"/>
    <Button x:Name="ScanButton" Content="Rileva istanze TIA / demo" Command="{Binding ScanCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
    <ComboBox x:Name="InstancesList" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectInstance}" Foreground="#10171F" Padding="10" Margin="0,0,0,8" AutomationProperties.Name="Istanza TIA Portal da selezionare"/>
    <TextBlock Text="{Binding SelectedInstance.ExecutablePath}" Foreground="#A1B2C4" Margin="0,0,0,4"/>
    <TextBlock Text="{Binding SelectedInstance.ProjectPath}" Foreground="#A1B2C4" Margin="0,0,0,12"/>
    <CheckBox x:Name="RealConsent" Content="Confermo il collegamento al PID selezionato su un progetto di prova, in sola lettura" IsChecked="{Binding RealConsent}" IsEnabled="{Binding CanSelectInstance}" Foreground="#E5EDF5" Margin="0,0,0,16"/>
    <WrapPanel><Button x:Name="ConnectButton" Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"/><Button x:Name="DisconnectButton" Content="Disconnetti" Command="{Binding DisconnectCommand}"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
    <DockPanel><TextBlock Text="04   COMPONENTI DEL PROGETTO" Foreground="#A1B2C4" FontWeight="Bold"/><TextBlock Text="{Binding ModeLabel}" HorizontalAlignment="Right" Foreground="#F4C574" FontWeight="SemiBold"/></DockPanel>
    <TextBlock Text="{Binding ComponentSummary}" Foreground="#A1B2C4" Margin="0,12,0,8"/>
    <ItemsControl x:Name="ComponentsList" ItemsSource="{Binding Components}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="#2C3D4E" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}" Foreground="#F4C574" FontWeight="Bold"/>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="#A1B2C4" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="{Binding Project}" Foreground="#A1B2C4" FontSize="12"/><TextBlock Text="{Binding Path}" Foreground="#A1B2C4" FontSize="12"/></StackPanel>
     </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
   <Border x:Name="ExportCard" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="05   ESPORTAZIONE PLC" Foreground="#A1B2C4" FontWeight="Bold"/>
    <TextBlock Text="Analisi → documenti XML → pacchetto ZIP" FontSize="20" Margin="0,12,0,8"/>
    <TextBlock Text="Esporta blocchi, UDT e tabelle variabili dalle sessioni aperte. Ogni operazione crea una cartella nuova con manifest ed esiti. Nessuna modifica al progetto PLC." Foreground="#A1B2C4" Margin="0,0,0,12"/>
    <TextBlock Text="Cartella di destinazione" Foreground="#A1B2C4"/>
    <TextBox x:Name="ExportRoot" Text="{Binding ExportRoot, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeMode}" Padding="10" Margin="0,6,0,12" AutomationProperties.Name="Cartella di destinazione esportazione"/>
    <TextBlock Text="Domanda da includere nel pacchetto" Foreground="#A1B2C4"/>
    <WrapPanel Margin="0,8,0,12" IsEnabled="{Binding CanChangeMode}">
     <CheckBox Content="Cache analisi" IsChecked="{Binding UseAnalysisCache}" Foreground="#E5EDF5" Margin="0,0,20,0"/>
     <CheckBox Content="Report compatti" IsChecked="{Binding CompactReports}" Foreground="#E5EDF5" Margin="0,0,20,0" ToolTip="Gli XML originali restano completi; si evita di duplicarli nei report."/>
     <CheckBox Content="Riusa XML con impronta invariata" IsChecked="{Binding ReuseXml}" Foreground="#E5EDF5" ToolTip="Opzionale. In assenza di un'impronta affidabile viene eseguito l'export completo. Disattivare per una raccolta completamente nuova."/>
    </WrapPanel>
    <TextBox x:Name="Question" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeMode}" Padding="10" Margin="0,6,0,12" MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Domanda per l'analisi del progetto"/>
    <WrapPanel><Button x:Name="ExportXmlButton" Content="Esporta XML" Command="{Binding ExportXmlCommand}"/><Button x:Name="ExportZipButton" Content="Crea ZIP per ChatGPT" Command="{Binding ExportZipCommand}"/><Button x:Name="CancelExportButton" Content="Annulla esportazione" Command="{Binding CancelExportCommand}"/></WrapPanel>
    <TextBlock x:Name="ExportStatus" Text="{Binding ExportStatus}" Foreground="#A1B2C4" FontSize="12" Margin="0,12,0,0"/>
    <TextBlock Text="{Binding PerformanceSummary}" Foreground="#A1B2C4" FontSize="12" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding LastZipPath}" Foreground="#65E1C8" Margin="0,12,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
    <TextBlock Text="06   RICERCA SIMBOLI NELL'ULTIMO SNAPSHOT" Foreground="#A1B2C4" FontWeight="Bold"/>
    <TextBlock Text="Nome variabile o indirizzo; risultati con blocco e rete. Grafo e reti complete sono inclusi nel pacchetto." Foreground="#A1B2C4" Margin="0,12,0,8"/>
    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,12" AutomationProperties.Name="Variabile o indirizzo da cercare"/>
    <Button Content="Cerca simboli" Command="{Binding SearchSymbolsCommand}" HorizontalAlignment="Left"/>
    <TextBlock Text="{Binding SymbolSummary}" Foreground="#A1B2C4" Margin="0,12,0,8"/>
    <ItemsControl ItemsSource="{Binding SymbolMatches}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding Display}"/><TextBlock Text="{Binding File}" Foreground="#A1B2C4" FontSize="12"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
    <TextBlock Text="07   CONFRONTO TRA ESPORTAZIONI" Foreground="#A1B2C4" FontWeight="Bold"/>
    <TextBlock Text="Prima · manifest.json o ZIP" Foreground="#A1B2C4" Margin="0,12,0,6"/>
    <DockPanel><Button Content="Sfoglia…" Click="BrowsePreviousSnapshot" DockPanel.Dock="Right" Margin="12,0,0,0" IsEnabled="{Binding CanChangeMode}"/><TextBox Text="{Binding PreviousSnapshotPath, UpdateSourceTrigger=PropertyChanged}" Padding="10" IsEnabled="{Binding CanChangeMode}" AutomationProperties.Name="Snapshot precedente"/></DockPanel>
    <TextBlock Text="Dopo · manifest.json o ZIP" Foreground="#A1B2C4" Margin="0,12,0,6"/>
    <DockPanel><Button Content="Sfoglia…" Click="BrowseCurrentSnapshot" DockPanel.Dock="Right" Margin="12,0,0,0" IsEnabled="{Binding CanChangeMode}"/><TextBox Text="{Binding CurrentSnapshotPath, UpdateSourceTrigger=PropertyChanged}" Padding="10" IsEnabled="{Binding CanChangeMode}" AutomationProperties.Name="Snapshot successivo"/></DockPanel>
    <Button Content="Confronta snapshot" Command="{Binding CompareCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    <TextBlock Text="{Binding ComparisonStatus}" Foreground="#A1B2C4" Margin="0,12,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
    <TextBlock Text="08   DIAGNOSTICA SESSIONE / LOG IN MEMORIA" Foreground="#A1B2C4" FontWeight="Bold" Margin="0,0,0,12"/>
    <ItemsControl ItemsSource="{Binding LogEntries}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#A1B2C4" FontFamily="Consolas" FontSize="12" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <TextBlock Grid.Row="2" Text="V0.5   /   Analisi offline · nessun valore runtime                         .NET Framework 4.8 • x64" Foreground="#8A9EB2" FontSize="12" Margin="0,18,0,0"/>
 </Grid>
</Window>
