<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <SiemensPublicApiPath Condition="'$(SiemensPublicApiPath)' == ''">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48</SiemensPublicApiPath>
    <EnableSiemensOpenness Condition="'$(EnableSiemensOpenness)' == ''">false</EnableSiemensOpenness>
    <DefineConstants Condition="'$(EnableSiemensOpenness)' == 'true'">$(DefineConstants);SIEMENS_V21</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TiaAnalyzer.Core\TiaAnalyzer.Core.csproj" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSiemensOpenness)' == 'true'">
    <Reference Include="Siemens.Engineering.Base"><HintPath>$(SiemensPublicApiPath)\Siemens.Engineering.Base.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Siemens.Engineering.Step7"><HintPath>$(SiemensPublicApiPath)\Siemens.Engineering.Step7.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateSiemensReferences" BeforeTargets="ResolveReferences" Condition="'$(EnableSiemensOpenness)' == 'true'">
    <Error Condition="!Exists('$(SiemensPublicApiPath)\Siemens.Engineering.Base.dll') Or !Exists('$(SiemensPublicApiPath)\Siemens.Engineering.Step7.dll')" Text="EnableSiemensOpenness richiede entrambe le DLL Siemens V21 nel SiemensPublicApiPath locale. Non copiarle nel repository." />
  </Target>
</Project>
